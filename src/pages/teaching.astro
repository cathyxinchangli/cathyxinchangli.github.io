---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { teaching } from "../data/teaching";
---

<BaseLayout title="Teaching" description="Teaching experience of Xinchang Cathy Li.">
  <PageHero eyebrow="Teaching" title="Learning through systems thinking" intro="Teaching connects physical principles, computational methods, and the lived realities of cities." />

  <section class="section shell">
    <div class="section-header">
      <div><p class="section-kicker">Courses</p><h2>Teaching experience</h2></div>
    </div>
    <div class="timeline">
      {teaching.map((item) => (
        <article class="timeline-item">
          <div class="timeline-year">{item.years}</div>
          <div>
            <h2>{item.course}</h2>
            <h3>{item.role} · {item.institution}</h3>
            <p>{item.topics}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
