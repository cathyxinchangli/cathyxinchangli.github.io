---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { siteConfig } from "../config";

const social = [
  ["Google Scholar", siteConfig.links.scholar],
  ["ORCID", siteConfig.links.orcid],
  ["GitHub", siteConfig.links.github],
  ["LinkedIn", siteConfig.links.linkedin],
  ["ResearchGate", siteConfig.links.researchgate],
] as const;
---

<BaseLayout title="Contact" description="Contact Xinchang Cathy Li about research, collaboration, and PhD opportunities.">
  <PageHero eyebrow="Get in touch" title="Let’s start a conversation" />
  <div class="section shell contact-grid">
    <section aria-labelledby="prospective-students-heading">
      <h2 id="prospective-students-heading">Prospective PhD students</h2>
      <p class="contact-note">I am recruiting PhD students starting Summer or Fall 2027 (Spring 2027 is also possible). Read the <a href={siteConfig.recruitment.jobAdUrl} target="_blank" rel="noreferrer">PhD student opportunities job ad (PDF)<span class="sr-only"> in a new tab</span></a> for details.</p>
      <p class="contact-note">Please <a href={siteConfig.recruitment.surveyUrl}>complete the prospective student survey</a> to ensure your application is considered.</p>
    </section>
    <section aria-labelledby="collaboration-heading">
      <h2 id="collaboration-heading">Research & collaboration</h2>
      <a class="email-large" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
    </section>
    <section aria-labelledby="profiles-heading">
      <h2 id="profiles-heading">Profiles</h2>
      <div class="social-list">
        {social.map(([label, href]) => (
          <a href={href} target="_blank" rel="noreferrer"><span>{label}</span><span aria-hidden="true">↗</span></a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
